{
  "description": "Handoff: point new sessions at an open handoff, and auto-save a snapshot when a session stops on a usage limit. Set HANDOFF_HOOKS=0 to turn both off.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/handoff.py\" hook-session-start 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit|billing_error",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/handoff.py\" hook-stop-failure 2>/dev/null || true",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
